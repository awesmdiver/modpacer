{
  "manifest_version": 3,
  "name": "ModPacer browser helper",
  "version": "1.0.5",
  "description": "Lets ModPacer read the version of the LoversLab pages you follow, in your own browser with your own sign-in. It talks to ModPacer on this PC only.",
  "permissions": ["storage", "alarms"],
  "host_permissions": ["http://127.0.0.1/*"],
  "optional_host_permissions": ["https://www.loverslab.com/*"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "ModPacer browser helper", "default_popup": "popup.html", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" } }
}
